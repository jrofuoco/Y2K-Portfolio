---
import type { Project } from '../data/portfolio';
import Y2KIcon from './Y2KIcon.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="project-card"
  data-category={project.category}
  data-gsap="card"
>
  <a href={`/projects/${project.slug}`} class="project-link" aria-label={`View ${project.title} case study`}>
    <div class={`project-art ${project.artClass}`} data-tilt>
      <div class="project-art-top">
        <span class="project-badge">{project.number} / {project.category}</span>
        <span class="project-badge">{project.year}</span>
      </div>
      {project.artClass === 'art-hyperion' && (
        <span class="project-art-glyph" aria-hidden="true"><Y2KIcon name="starburst" /></span>
      )}
    </div>
    <div class="project-meta">
      <div>
        <h3>{project.title}</h3>
        <p>{project.tag}</p>
      </div>
      <span class="project-arrow" aria-hidden="true"><Y2KIcon name="arrow-tr" /></span>
    </div>
  </a>
</article>
