---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Creative Future — Y2K Portfolio',
  description = 'Digital designer crafting bold identities and interactive experiences.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="y2k-cursor" id="y2k-cursor" aria-hidden="true"></div>
    <Header />
    <main id="top">
      <slot />
    </main>
    <Footer />

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      function initY2KAnimations() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        ScrollTrigger.getAll().forEach((t) => t.kill());

        // 1. Custom Y2K Cursor with gsap.quickTo
        const cursor = document.getElementById('y2k-cursor');
        if (cursor && window.matchMedia('(hover: hover)').matches) {
          const xTo = gsap.quickTo(cursor, 'x', { duration: 0.22, ease: 'power3.out' });
          const yTo = gsap.quickTo(cursor, 'y', { duration: 0.22, ease: 'power3.out' });

          window.addEventListener('mousemove', (e) => {
            xTo(e.clientX);
            yTo(e.clientY);
          });

          document.querySelectorAll('a, button, [data-tilt]').forEach((el) => {
            el.addEventListener('mouseenter', () => cursor.classList.add('is-active'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('is-active'));
          });
        }

        // 2. Hero Entrance & Y2K Sparkle Flares
        const hero = document.querySelector('.mockup-hero');
        if (hero) {
          gsap.fromTo(
            hero,
            { opacity: 0, scale: 1.02 },
            { opacity: 1, scale: 1, duration: 0.9, ease: 'power3.out' }
          );

          gsap.to('.hero-sparkle', {
            scale: 1.35,
            rotation: 25,
            opacity: 0.65,
            duration: 1.6,
            stagger: 0.25,
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut',
          });
        }

        // 3. Page Hero Entrance on Inner Pages
        const pageHero = document.querySelector('.page-hero');
        if (pageHero) {
          const items = pageHero.querySelectorAll('.page-hero-hud, h1, .page-hero-lead');
          gsap.fromTo(
            items,
            { y: 36, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.75, stagger: 0.12, ease: 'power3.out' }
          );
        }

        // 4. Infinite Y2K Ticker Marquee
        const tickerTrack = document.querySelector('[data-ticker]');
        if (tickerTrack) {
          gsap.to(tickerTrack, {
            xPercent: -50,
            ease: 'none',
            duration: 22,
            repeat: -1,
          });
        }

        // 5. ScrollTrigger Section Reveals
        gsap.utils.toArray<HTMLElement>('[data-gsap="reveal"]').forEach((el) => {
          gsap.fromTo(
            el,
            { y: 44, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.8,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 86%',
                toggleActions: 'play none none none',
              },
            }
          );
        });

        // 6. Staggered Project, Service & Gallery Cards
        gsap.utils
          .toArray<HTMLElement>('.projects-grid, .services-grid, .metrics-grid, .screenshot-grid, .pov-grid')
          .forEach((grid) => {
          const cards = grid.querySelectorAll('[data-gsap="card"]');
          if (cards.length) {
            gsap.fromTo(
              cards,
              { y: 50, opacity: 0 },
              {
                y: 0,
                opacity: 1,
                duration: 0.75,
                stagger: 0.14,
                ease: 'power3.out',
                scrollTrigger: {
                  trigger: grid,
                  start: 'top 84%',
                },
              }
            );
          }
        });

        // 7. Segmented Y2K Skill Meter Bars (CREATIVE MODE style)
        gsap.utils.toArray<HTMLElement>('[data-skill-level]').forEach((bar) => {
          const targetWidth = bar.getAttribute('data-skill-level') || '80';
          gsap.fromTo(
            bar,
            { width: '0%' },
            {
              width: `${targetWidth}%`,
              duration: 1.25,
              ease: 'steps(14)',
              scrollTrigger: {
                trigger: bar,
                start: 'top 88%',
              },
            }
          );
        });

        // 8. 3D Y2K Card Tilt on Hover
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const relX = (e.clientX - rect.left) / rect.width - 0.5;
            const relY = (e.clientY - rect.top) / rect.height - 0.5;
            gsap.to(card, {
              rotateY: relX * 10,
              rotateX: -relY * 10,
              transformPerspective: 800,
              duration: 0.35,
              ease: 'power2.out',
            });
          });

          card.addEventListener('mouseleave', () => {
            gsap.to(card, {
              rotateY: 0,
              rotateX: 0,
              duration: 0.6,
              ease: 'elastic.out(1, 0.5)',
            });
          });
        });

        // 9. Magnetic Buttons
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((btn) => {
          btn.addEventListener('mousemove', (e) => {
            const rect = btn.getBoundingClientRect();
            const x = (e.clientX - rect.left - rect.width / 2) * 0.25;
            const y = (e.clientY - rect.top - rect.height / 2) * 0.25;
            gsap.to(btn, { x, y, duration: 0.25, ease: 'power2.out' });
          });

          btn.addEventListener('mouseleave', () => {
            gsap.to(btn, { x: 0, y: 0, duration: 0.45, ease: 'elastic.out(1, 0.4)' });
          });
        });

        // 10. Rotating Logo Star
        gsap.to('.logo-star', {
          rotation: 360,
          duration: 12,
          repeat: -1,
          ease: 'none',
        });
      }

      document.addEventListener('astro:page-load', initY2KAnimations);
    </script>
  </body>
</html>
