---
import BaseLayout from '../layouts/BaseLayout.astro';
import Y2KIcon from '../components/Y2KIcon.astro';
import { services, servicesInfo } from '../data/portfolio';

const processSteps = [
  {
    step: '01',
    name: 'REQUIREMENTS & PLANNING',
    desc: 'Understanding your problem, target users, and technical requirements for Android or web.',
  },
  {
    step: '02',
    name: 'UI/UX & ARCHITECTURE',
    desc: 'Structuring clean interfaces, database schemas, and API endpoints before writing code.',
  },
  {
    step: '03',
    name: 'DEVELOPMENT & INTEGRATION',
    desc: 'Building the Android app or responsive website and connecting real backend services.',
  },
  {
    step: '04',
    name: 'TESTING & DEPLOYMENT',
    desc: 'Rigorous testing across devices, performance checks, and smooth launch.',
  },
];
---

<BaseLayout
  title="Services — Joshua Orlina | Android & Web Development"
  description={servicesInfo.intro}
>
  <section class="page-hero">
    <div class="page-hero-hud">
      <span>SERVICES // 01 — 03 CORE SPECIALIZATIONS</span>
      <span>SYS // ANDROID & WEB ENGINEERING</span>
    </div>
    <h1>Services.<br /><em>Built to work.</em></h1>
    <p class="page-hero-lead">
      {servicesInfo.intro}
    </p>
  </section>

  <!-- 01 - 03 Services Index & Breakdown -->
  <section class="section section--deep">
    <div class="section-head" data-gsap="reveal">
      <div>
        <p class="overline">SERVICES // 01 — 03</p>
        <h2>What I<br /><em>develop.</em></h2>
      </div>
      <p>
        {servicesInfo.intro}
      </p>
    </div>

    <!-- 01 - 03 Dossier Summary List -->
    <div class="dossier-list" style="margin-bottom: 56px;" data-gsap="reveal">
      {
        services.map((service) => (
          <a href={`#${service.id}`} class="dossier-item">
            <div class="dossier-row">
              <span class="dossier-num">{service.number}</span>
              <h3 class="dossier-title">{service.title}</h3>
              <p class="dossier-sub">{service.subtitle}</p>
              <span class="dossier-symbol" aria-hidden="true">{service.symbol}</span>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Detailed Capability Cards -->
    <div class="projects-grid">
      {
        services.map((service) => (
          <article class="hud-frame service-card" id={service.id} data-gsap="card">
            <div>
              <div class="service-card-top">
                <span>{service.number} // SERVICE</span>
                <span>{service.hudCode}</span>
              </div>
              <h3 style="text-transform: uppercase;">{service.title}</h3>
              <p style="font-weight: 600; color: #fff; margin-bottom: 10px;">{service.subtitle}</p>
              <p>{service.description}</p>
            </div>
            <div>
              <p class="overline" style="margin-bottom: 12px;">KEY FOCUS:</p>
              <ul class="deliverables-list" style="grid-template-columns: 1fr;">
                {service.deliverables.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 4-Step Execution Pipeline -->
  <section class="section section--light">
    <div class="section-head" data-gsap="reveal">
      <div>
        <p class="overline">WORKFLOW // THE PIPELINE</p>
        <h2>How I build<br /><em>your product.</em></h2>
      </div>
      <p>A straightforward four-stage workflow from initial requirements to deployment.</p>
    </div>

    <div class="services-grid">
      {
        processSteps.map((p) => (
          <div
            class="hud-frame service-card"
            style="background: #041442; color: #fff;"
            data-gsap="card"
          >
            <div class="service-card-top">
              <span>PHASE // {p.step}</span>
              <span>WORKFLOW</span>
            </div>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Booking CTA -->
  <section class="section section--cobalt" style="text-align: center;">
    <div data-gsap="reveal">
      <p class="overline">NEED AN ANDROID APP OR WEBSITE?</p>
      <h2>Let's build<br /><em>together.</em></h2>
      <div style="margin-top: 28px;">
        <a href="/contact" class="y2k-btn y2k-btn--light" data-magnetic>
          <span>GET IN TOUCH <Y2KIcon name="arrow-tr" /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
